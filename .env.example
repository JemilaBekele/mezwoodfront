# ==========================================
# Mezwoodfront (Next.js) — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ------------------------------------------
# API Connection
# ------------------------------------------
# Base URL for backend API requests (used by apiConfig.ts).
# The mezidwood backend listens on 7000 (see its .env PORT).
NEXT_PUBLIC_API_URL=http://localhost:7000/api

# ------------------------------------------
# Backend URL (for image/resource paths)
# ------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:7000

# ------------------------------------------
# Public App URL (for shareable links)
# ------------------------------------------
NEXT_PUBLIC_URL=http://localhost:3030
